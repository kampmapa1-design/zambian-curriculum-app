rules_version = '2';

// Teacher Submissions Dashboard (Stage 11, added 2026-09-02) — every file
// under teacher_submissions/ is uploaded ONLY by the
// `submitToTeacherDashboard` Cloud Function via the Admin SDK, which
// bypasses these rules. No client reads or writes these files directly:
// the Dashboard screen opens a signed, time-limited download URL that
// same Cloud Function hands back at upload time (and can re-request one
// later, since a plain gs:// path isn't independently readable by a
// client with these rules in place) — see submitToTeacherDashboard's
// comment for why a signed URL, not a public one.
service firebase.storage {
  match /b/{bucket}/o {
    match /teacher_submissions/{allPaths=**} {
      allow read, write: if false;
    }

    // "Share the Photo Batch" (Scan Marker, 2026-09-10, per explicit
    // request) — unlike teacher_submissions above, the CLIENT itself
    // uploads directly here (via the firebase_storage SDK — no Cloud
    // Function payload-size ceiling to work around for what can be a
    // large multi-script PDF), so this needs a real client-write rule,
    // not admin-SDK-only. Scoped strictly to the uploader's own uid
    // segment — a signed teacher can only write under their own
    // photo_batches/{their uid}/ path, never another's, and reads stay
    // denied here too: the app always opens a time-limited signed URL
    // from getPhotoBatchUrl, same "no client reads a plain gs:// path
    // directly" reasoning as teacher_submissions above. 25MB cap per
    // file, PDF only — matches the one real use (one composed PDF per
    // batch), not a general-purpose upload bucket.
    match /photo_batches/{uid}/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Timetable Generation, Stage 12 (added 2026-09-14) — a school's
    // logo, embedded as a header on branded exports (see
    // SchoolBrandingService). Fixed single path per school, no
    // per-uid segment: any member of that school can READ it (a logo
    // isn't sensitive — the whole point is putting it on shared
    // exports), gated the same cheap way as Firestore's own
    // `schools/{schoolId}` rules (the caller's own custom claims, no
    // extra lookup). Only leadership/administrator can WRITE it —
    // same roles allowed to pin a Staffroom post.
    // Home Assignment epic, Stage 8/9 (added 2026-09-14) — a submission's
    // answer photos. `{uploaderUid}` is whoever's device actually
    // uploaded them: the pupil themselves for an in-app submission
    // (Stage 8), or the subject teacher's own uid for a bulk-imported one
    // (Stage 9, external photos with no pupil account behind them at
    // all) — either way, only that same signed-in uid may write there,
    // and only when they genuinely belong to this school/class one way or
    // the other. Read is any staff member of the school (to mark/review)
    // — mirrors every other read gate in this app's School Network data.
    match /schools/{schoolId}/classes/{classId}/homeAssignments/{assignmentId}/submissions/{uploaderUid}/{fileName} {
      allow read: if request.auth != null && request.auth.token.schoolId == schoolId;
      allow write: if request.auth != null
        && request.auth.uid == uploaderUid
        && (request.auth.token.schoolId == schoolId ||
            (request.auth.token.pupilSchoolId == schoolId && request.auth.token.pupilClassId == classId))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /schools/{schoolId}/logo {
      allow read: if request.auth != null && request.auth.token.schoolId == schoolId;
      allow write: if request.auth != null
        && request.auth.token.schoolId == schoolId
        && request.auth.token.schoolRole in ["head_teacher", "deputy", "administrator"]
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
